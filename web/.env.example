# Copy to .env.local for local work; on Vercel set these under Settings → Environment Variables.
# Everything here is public (it ends up in the browser). Never put a secret key in a VITE_ variable.

# "false" turns off the mock accounts and the sign-up helper.
VITE_DEMO_MODE=true

# Shown in the footer, the legal pages and Help. All optional: whatever is empty is simply not shown.
VITE_COMPANY_NAME=Pethommie
VITE_CONTACT_EMAIL=
# International digits without "+", for example 6281234567890
VITE_CONTACT_WHATSAPP=

# Backend (see docs/backend). Not read by the app yet.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
