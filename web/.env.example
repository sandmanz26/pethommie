# Copy to .env.local for local work; on Vercel set these under Settings → Environment Variables.
# Everything here is public (it ends up in the browser). Never put a secret key in a VITE_ variable.

# "false" turns off the mock accounts and the sign-up helper.
VITE_DEMO_MODE=true

# Shown in the footer, the legal pages and Help. All optional: whatever is empty is simply not shown.
VITE_COMPANY_NAME=Siomofu
VITE_CONTACT_EMAIL=
# International digits without "+", for example 6281234567890
VITE_CONTACT_WHATSAPP=

# Backend: Supabase (see docs/backend/google-login.md). Leave empty to run fully local, with the mock accounts.
# With both set, registering and logging in go through Google, and a hotel's data syncs to the project.
# Only the anon key: never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The API in web/api (Vercel functions) reads SUPABASE_URL and SUPABASE_ANON_KEY (server-side; same values as above),
# and falls back to the two VITE_ ones. See docs/backend/setup-supabase.md.
#
# Email notifications (see docs/backend/email-setup.md) are the one feature that needs the service-role key, server-
# side only, never as a VITE_ variable: RESEND_API_KEY, EMAIL_FROM, SUPABASE_SERVICE_ROLE_KEY, EMAIL_DISPATCH_SECRET,
# APP_URL. Leave these empty to skip email: the booking link still works exactly as before, WhatsApp only.

# Anonymous page-view analytics (PostHog), see docs/backend/analytics-setup.md. Leave empty to skip it entirely.
VITE_POSTHOG_KEY=
# Default: PostHog Cloud (US). Only needed for the EU region or a self-hosted instance.
VITE_POSTHOG_HOST=
